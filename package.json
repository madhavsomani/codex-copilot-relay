{
  "name": "codex-copilot-relay",
  "version": "1.3.2",
  "private": true,
  "description": "Unofficial localhost OpenAI Responses compatibility relay from Codex custom providers to the official GitHub Copilot SDK.",
  "main": "server.mjs",
  "scripts": {
    "probe": "node probe-sdk.mjs",
    "probe:tools": "node probe-tools.mjs",
    "probe:tools-relay": "node probe-relay-tools.mjs",
    "probe:compatibility": "node probe-compatibility.mjs",
    "probe:concurrency": "node probe-concurrency.mjs",
    "probe:stream": "node probe-responses-stream.mjs",
    "probe:premature-recovery": "node probe-premature-recovery.mjs",
    "probe:delayed-tool": "node probe-delayed-tool.mjs",
    "probe:failure-stream": "node probe-failure-stream.mjs",
    "probe:reasoning-phase": "node probe-reasoning-phase.mjs",
    "probe:deferred-tool": "node probe-deferred-tool.mjs",
    "probe:request-semantics": "node probe-request-semantics.mjs",
    "probe:tool-choice": "node probe-tool-choice.mjs",
    "probe:agent-message": "node probe-agent-message.mjs",
    "probe:codex-heartbeat": "node probe-codex-heartbeat.mjs",
    "probe:client-disconnect": "node probe-client-disconnect.mjs",
    "start": "node server.mjs",
    "test": "node --test"
  },
  "keywords": [
    "codex",
    "github-copilot",
    "copilot-sdk",
    "openai-responses",
    "localhost-bridge"
  ],
  "author": {
    "name": "Madhav Somani",
    "url": "https://www.linkedin.com/in/madhavsomani"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madhavsomani/codex-copilot-relay.git"
  },
  "bugs": {
    "url": "https://github.com/madhavsomani/codex-copilot-relay/issues"
  },
  "homepage": "https://github.com/madhavsomani/codex-copilot-relay#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.11",
    "@openai/codex": "0.147.0",
    "tiktoken": "1.0.22"
  }
}
